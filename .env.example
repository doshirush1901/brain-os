# Brain OS — environment template (copy to .env; never commit .env)
#
# cp .env.example .env && ./scripts/macpro/bootstrap.sh

# ── Data directory ─────────────────────────────────────────────
BRAIN_DATA_DIR=./data
# Legacy (migration): BRAIN_DATA_DIR is still read if BRAIN_DATA_DIR is unset.

# ── LLM (required for brain ask / agents) ─────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Embeddings (Qdrant ingest / retrieval) ─────────────────────
VOYAGE_API_KEY=

# ── Database (Postgres from docker-compose.local.yml) ─────────
# Compose creates DB name brain_crm (POSTGRES_DB).
DATABASE_URL=postgresql+asyncpg://brain:brain@localhost:5432/brain_crm

# ── Vector + graph (defaults match docker-compose.local.yml) ──
QDRANT_URL=http://localhost:6333
# Compose publishes Neo4j bolt on host 7688 (container 7687).
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
# Default Redis host port 6379. If busy, map "6380:6379" in compose and use:
# REDIS_URL=redis://localhost:6380/0
REDIS_URL=redis://localhost:6379/0

# ── Optional memory (Mem0) ─────────────────────────────────────
MEM0_API_KEY=

# ── App defaults ───────────────────────────────────────────────
APP__ENVIRONMENT=development
APP__DEFAULT_USER_ID=brain-operator
APP__PIPELINE_TIMEOUT=300

# Email: TRAINING = draft-only; OPERATIONAL = send gates (never auto-send)
BRAIN_EMAIL_MODE=TRAINING

# ── Licensing ──────────────────────────────────────────────────
# BRAIN_LICENSE_SERVER_URL=http://127.0.0.1:8765
# BRAIN_LICENSE_STUB_ACCEPT=1
# Run: poetry run python scripts/license_server_stub.py
